# ============================================================================
# AgentCore Platform — ignore rules
#
# Policy:
#   * Secrets are NEVER committed. Only `.env.example` is tracked.
#   * Runtime state (SQLite, JSONL traces) is NEVER committed.
#   * Internal/private working notes are NEVER committed.
#   * `uv.lock` IS committed — it is the reproducibility guarantee.
# ============================================================================

# --- Secrets / environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
secrets.*
credentials.json

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
ENV/
.python-version.bak

# --- Python tooling caches -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/

# --- uv --------------------------------------------------------------------
# `uv.lock` is committed on purpose. The local cache is not.
.uv/

# --- Node (web service tooling, if ever added) -----------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- Runtime data (SQLite, JSONL traces, uploads) ---------------------------
data/
!data/.gitkeep

# Chainlit's upload directory, created in whatever working directory Chainlit is started from —
# `services/chat` for `devtasks chat`, whose docstring explains why that cwd is pinned. It is empty
# for this app, because no endpoint accepts an upload and the feature is switched off in
# `services/chat/.chainlit/config.toml`; ignoring the directory keeps Chainlit's re-created empty
# folder out of `git status`.
.files/

# Chainlit copies its own twenty-three translation files into the app's `.chainlit/translations/`
# on startup if they are missing (see `ensure_translations` in its `config.py`), so this directory
# is a generated copy of a dependency's data rather than anything this repository authors. Committing
# it would add twenty-three files of pure noise, and every Chainlit upgrade would show them as
# modified. `services/chat/.chainlit/config.toml`, which *is* ours, stays tracked — the negation is
# what keeps it visible while its sibling directory is ignored.
services/chat/.chainlit/translations/

# Starting Chainlit by hand from the repository root — rather than through `devtasks chat`, which
# pins its working directory to `services/chat` — makes it create a `.chainlit/` here as well: a
# default `config.toml` and the same generated translations. Nothing under it is authored here, so
# it is ignored; the rule is root-anchored so the tracked `services/chat/.chainlit/config.toml`
# above stays visible.
/.chainlit/
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# --- Eval scratch ----------------------------------------------------------
# NOTE: eval/results/latest.{md,json} ARE committed — they are the evidence
# required by the assignment. Only transient artefacts are ignored.
eval/.cache/
eval/results/*.tmp

# --- Documentation: only what a reviewer needs is published -----------------
# The planning record, the architecture notes, the runbooks and the brief itself are
# internal working material and are deliberately NOT published: they are how the work
# was done, not part of the deliverable. They stay on disk and stay readable locally.
#
# Three directories under docs/ ARE published, because each is evidence rather than
# planning:
#
#   media/        the screenshots the assignment asks for, and the eval console run
#   starter-kit/  the kit's own documentation and the checksum manifest that proves
#                 the mock fixture has not been edited (a unit test reads it on every
#                 run, so hiding it would break a fresh clone)
#   adr/          the five decision records the README cites by name
#
# The negations keep working only because `docs/*` excludes the *children* of docs/
# rather than docs/ itself — git cannot re-include a file whose parent directory has
# been excluded outright.
docs/*
!docs/media/
!docs/starter-kit/
!docs/adr/

notes/
docs/internal/
docs/scratch/
*.local.md
*.local.json
*.local.yaml
.local/

# --- Media: commit screenshots and small GIFs, not raw recordings -----------
*.mp4
*.mov
*.mkv
*.avi

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*~
