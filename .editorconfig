# ============================================================================
# EditorConfig — consistent formatting regardless of editor or OS.
# https://editorconfig.org
# ============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{json,jsonl,yml,yaml,toml}]
indent_size = 2

[*.{html,css,js,mjs,ts,tsx}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (hard line breaks, tables).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{sqlite,sqlite3,db,png,jpg,jpeg,gif,ico,webp,pdf,zip,gz,woff,woff2}]
insert_final_newline = false
