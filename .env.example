# ============================================================================
# AgentCore Platform — environment template
#
#   cp .env.example .env      (then edit .env; it is gitignored)
#
# Nothing here is a real secret. Every value has a working default so that
# `docker compose up` starts a fully functional stack with NO API key: the
# default model provider is the deterministic `scripted` provider.
#
# SECURITY: never commit `.env`. API keys entered in the web UI (only when
# ALLOW_RUNTIME_KEY_ENTRY=1) are held in the agent process's memory, are never
# written to the database, logs, traces or any HTTP response, and are lost on
# restart. See docs/runbooks/provider-setup.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Mock ticketing system (the starter kit — see mock-ticketing/)
# ---------------------------------------------------------------------------
# Shared secret between the MCP server and the mock. The agent never sees it.
API_KEY=dev-key-123

# Fault injection. FLAKY=1 makes ~FLAKY_RATE of requests fail with 429
# (Retry-After: 1) or 500 before the handler runs. FLAKY_SEED makes the
# sequence deterministic, which is what the eval suite relies on.
FLAKY=0
FLAKY_RATE=0.3
FLAKY_SEED=

# Artificial delay added to every protected request, in milliseconds.
LATENCY_MS=0

# ---------------------------------------------------------------------------
# MCP server (services/mcp-ticketing) — the only route from agent to mock
# ---------------------------------------------------------------------------
# stdio | http. http is used in containers; stdio is used by tests and local dev.
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8081

# Shared secret the agent must present (X-MCP-Token) on the HTTP transport.
MCP_TOKEN=dev-mcp-token

# How the MCP server reaches the mock. Compose sets this to the service name.
TICKETING_BASE_URL=http://ticketing:8000
TICKETING_API_KEY=${API_KEY}

# Per-attempt timeout, and the overall deadline across all attempts.
TICKETING_TIMEOUT_S=5
TICKETING_DEADLINE_S=20

# Retry policy. 401/404/422 are never retried; 429 honours Retry-After.
TICKETING_MAX_ATTEMPTS=4
TICKETING_BACKOFF_BASE_S=0.4
TICKETING_BACKOFF_MAX_S=4.0

# Idempotency ledger: maps a client_request_id to the result of the write it
# produced, so a retry can never create a second ticket.
#
# The name is TICKETING_*, not MCP_*, because it is the mechanism that protects
# *writes to the ticketing system*, and it is the exact variable the server reads
# (see ENV_LEDGER_PATH in services/mcp-ticketing/src/ticketing_mcp/config.py).
# This file said `MCP_DB_PATH` for a while — a variable nothing reads. Setting only
# that left the server on its relative default under a root-owned working
# directory, and it died at container startup with a PermissionError that read like
# a permissions problem rather than a path one.
#
# Default when unset: data/ticketing-idempotency.sqlite3, relative to the cwd.
TICKETING_LEDGER_PATH=/data/mcp.sqlite3

# ---------------------------------------------------------------------------
# Agent service (services/agent) — AgentCore Runtime contract on :8080
# ---------------------------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8080

# scripted | replay | anthropic | openai | openai_compatible | bedrock
# `scripted` and `replay` are deterministic and need no key: they are what the
# eval suite and CI use. The web UI can switch provider at runtime.
AGENT_MODEL_PROVIDER=scripted
# Leave empty to use the provider's default model.
AGENT_MODEL_ID=

# Orchestration budgets.
AGENT_MAX_STEPS=10
AGENT_REQUEST_DEADLINE_S=90

# How long a proposed write stays approvable before it expires.
AGENT_APPROVAL_TTL_S=1800

# Memory: how many conversation turns are replayed verbatim before summarising,
# and how long a cross-session user fact stays valid.
AGENT_HISTORY_MAX_TURNS=20
AGENT_MEMORY_FACT_TTL_DAYS=180

# SQLite by default (WAL, stored in the mounted ./data volume).
# Any SQLAlchemy URL is accepted, but no Postgres driver is installed in this
# build: `postgresql://...` would be rejected at connect time with "no driver".
# Moving to Postgres means adding `psycopg[binary]` to services/agent/pyproject.toml,
# re-locking, and adding the service — the schema itself is already portable
# (Alembic migrations, no SQLite-specific column types).
DATABASE_URL=sqlite:////data/agent.sqlite3

# Structured JSON traces (one file per request) plus a queryable index.
TRACE_DIR=/data/traces
LOG_LEVEL=INFO

# --- Model provider credentials (optional) ---------------------------------
# The stack runs without any of these. Add the one you want to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama / vLLM / LM Studio / Groq / Together: an OpenAI-compatible base URL.
OPENAI_BASE_URL=

# --- Amazon Bedrock (optional, not needed for this assignment) -------------
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=

# --- Dev-only: accept an API key from the web UI --------------------------
# 0 (default) = keys come from this file only; the UI may only SELECT among
#               providers that are already configured.
# 1           = the UI may submit a key, which is kept in process memory only.
#               Never enable this on anything internet-facing.
ALLOW_RUNTIME_KEY_ENTRY=0

# --- OpenTelemetry export (optional) --------------------------------------
# Empty = tracing stays local (JSONL + SQLite). Set an OTLP endpoint to also
# export spans using the GenAI semantic conventions.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentcore-platform

# ---------------------------------------------------------------------------
# Web UI (services/web) — nginx on :3000, proxies /api/* to the agent
# ---------------------------------------------------------------------------
WEB_PORT=3000
AGENT_BASE_URL=http://agent:8080

# ---------------------------------------------------------------------------
# Eval runner (eval/) — where it points and how strict it is
# ---------------------------------------------------------------------------
EVAL_BASE_URL=http://localhost:8080
EVAL_TICKETING_URL=http://localhost:8000
EVAL_TICKETING_API_KEY=${API_KEY}
# Provider used for eval runs. Keep `scripted` for reproducible results.
EVAL_PROVIDER=scripted
