# ============================================================================
# AgentCore Platform — environment template
#
#   cp .env.example .env      (then edit .env; it is gitignored)
#
# Nothing here is a real secret. Every value has a working default so that
# `docker compose up` starts a fully functional stack with NO API key: the
# default model provider is the deterministic `scripted` provider.
#
# SECURITY: never commit `.env`. Keys are read from this file (or the shell), and
# only from there: there is no endpoint that accepts a key, and none is ever written
# to the database, a log, a trace or an HTTP response. Section c of README.md lists
# the providers and says what each one needs.
# ============================================================================

# ---------------------------------------------------------------------------
# Mock ticketing system (the starter kit — see mock-ticketing/)
# ---------------------------------------------------------------------------
# Shared secret between the MCP server and the mock. The agent never sees it.
API_KEY=dev-key-123

# Fault injection. FLAKY=1 makes ~FLAKY_RATE of requests fail with 429
# (Retry-After: 1) or 500 before the handler runs. FLAKY_SEED makes the
# sequence deterministic, which is what the eval suite relies on.
FLAKY=0
FLAKY_RATE=0.3
FLAKY_SEED=

# Artificial delay added to every protected request, in milliseconds.
LATENCY_MS=0

# ---------------------------------------------------------------------------
# MCP server (services/mcp-ticketing) — the only route from agent to mock
# ---------------------------------------------------------------------------
# stdio | http. http is used in containers; stdio is used by tests and local dev.
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8081

# Shared secret the agent must present (X-MCP-Token) on the HTTP transport.
MCP_TOKEN=dev-mcp-token

# How the MCP server reaches the mock. Compose sets this to the service name.
TICKETING_BASE_URL=http://ticketing:8000
TICKETING_API_KEY=${API_KEY}

# Per-attempt timeout, and the overall deadline across all attempts.
TICKETING_TIMEOUT_S=5
TICKETING_DEADLINE_S=20

# Retry policy. 401/404/422 are never retried; 429 honours Retry-After.
TICKETING_MAX_ATTEMPTS=4
TICKETING_BACKOFF_BASE_S=0.4
TICKETING_BACKOFF_MAX_S=4.0

# Idempotency ledger: maps a client_request_id to the result of the write it
# produced, so a retry can never create a second ticket.
#
# The name is TICKETING_*, not MCP_*, because it is the mechanism that protects
# *writes to the ticketing system*, and it is the exact variable the server reads
# (see ENV_LEDGER_PATH in services/mcp-ticketing/src/ticketing_mcp/config.py).
# This file said `MCP_DB_PATH` for a while — a variable nothing reads. Setting only
# that left the server on its relative default under a root-owned working
# directory, and it died at container startup with a PermissionError that read like
# a permissions problem rather than a path one.
#
# Default when unset: data/ticketing-idempotency.sqlite3, relative to the cwd.
TICKETING_LEDGER_PATH=/data/mcp.sqlite3

# ---------------------------------------------------------------------------
# Agent service (services/agent) — AgentCore Runtime contract on :8080
# ---------------------------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8080

# scripted | replay | anthropic | openai | openai_compatible | bedrock
#
# `scripted` and `replay` are deterministic and need no key: they are what the eval
# suite and CI run on, and `scripted` is the default so a bare `docker compose up`
# is a working stack rather than a configuration exercise.
#
# This value is the *initial* provider, and it is what an installation with no stored
# choice uses. Changing it is no longer the only way to change provider: the chat has a
# model control in its header that switches provider and model at runtime, and the
# choice is stored in the `provider_settings` table, so it is still in force after a
# restart. A stored choice this process can no longer build — a key that was removed —
# is refused at startup with a log line, and the configured provider above is kept
# instead.
AGENT_MODEL_PROVIDER=scripted
# Leave empty to use the provider's default model. The chat offers the provider's own
# default plus, for the OpenAI-shaped providers, the ids the endpoint actually serves.
AGENT_MODEL_ID=

# Orchestration budgets.
AGENT_MAX_STEPS=10
AGENT_REQUEST_DEADLINE_S=90

# How long a proposed write stays approvable before it expires.
AGENT_APPROVAL_TTL_S=1800

# Memory: how many conversation turns are replayed verbatim before summarising,
# and how long a cross-session user fact stays valid.
AGENT_HISTORY_MAX_TURNS=20
AGENT_MEMORY_FACT_TTL_DAYS=180

# SQLite by default (WAL, stored in the mounted ./data volume).
# Any SQLAlchemy URL is accepted, but no Postgres driver is installed in this
# build: `postgresql://...` would be rejected at connect time with "no driver".
# Moving to Postgres means adding `psycopg[binary]` to services/agent/pyproject.toml,
# re-locking, and adding the service — the schema itself is already portable
# (Alembic migrations, no SQLite-specific column types).
DATABASE_URL=sqlite:////data/agent.sqlite3

# Structured JSON traces (one file per request) plus a queryable index.
TRACE_DIR=/data/traces
LOG_LEVEL=INFO

# --- Model provider credentials (optional) ---------------------------------
# The stack runs without any of these. Add the one you want, restart the stack, and
# then either set AGENT_MODEL_PROVIDER above or pick the provider in the chat's model
# control — which needs no restart.
#
# A key is read from here (or the shell) and nowhere else. It is held inside the
# provider instance, is never sent to a client, and is never written to the database,
# a log or a trace. The chat chooses *which* configured provider is used; it cannot
# supply a key, and no endpoint accepts one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama / vLLM / LM Studio / Groq / Together: an OpenAI-compatible base URL.
# Setting this alone does not select `openai_compatible` — AGENT_MODEL_PROVIDER does —
# it makes that provider buildable without a key.
OPENAI_BASE_URL=

# --- Amazon Bedrock (optional, not needed for this assignment) -------------
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=

# --- OpenTelemetry export (optional) --------------------------------------
# Empty = tracing stays local (JSONL + SQLite). Set an OTLP endpoint to also
# export spans using the GenAI semantic conventions.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentcore-platform

# ---------------------------------------------------------------------------
# The chat front end (services/chat) — the only front end, and its own environment
# ---------------------------------------------------------------------------
# The agent serves no page of its own: `GET /` on AGENT_PORT is a 404, and this Chainlit
# app is the UI. It is a client of the same HTTP API a curl call reaches: the conversation,
# each tool call as a collapsible step, and the approval as two buttons in the chat. Start it with
# `uv run python -m devtasks chat`, which uses its own uv project — it can never share this
# workspace's environment, because Chainlit requires `mcp<2` while the MCP server requires
# `mcp>=2`. See services/chat/pyproject.toml for the full reason.
#
# Nothing below is required to start it: every value has a working default, and the default is the
# single-user anonymous chat.
#
# Where the agent it talks to is. Compose sets the service name when the chat runs as a
# container; the default is the published port, because running the chat on the host against a
# compose stack is the common case and should need no configuration at all. (`devtasks chat`
# translates the compose service name to loopback for a host run, so a value copied from a
# compose-oriented section above cannot send it to a hostname that resolves only inside the
# network.)
AGENT_BASE_URL=http://localhost:8080
# Whose conversation this is, when nobody logs in. Memory, approvals and traces are per user, so
# one identity for the whole chat instance is right for a demo — and it is the one value here a
# real deployment would take from an identity provider rather than from the environment.
CHAT_USER_ID=chainlit-user
#
# Which provider the chat asks the agent for when the agent is still on its deterministic default.
# The agent's own default — `AGENT_MODEL_PROVIDER` above — is `scripted`, which is right for the
# eval suite and wrong for somebody who has just opened a chat, because the reply they read was
# chosen by a rule rather than by a model. So the chat has a default of its own, and it is this.
#
# It speaks only when no model is answering and only when this value is in the agent's `available`
# list, so a deployment with no OpenAI key stays on `scripted` with nothing to configure and no
# error to explain. Leave it empty to disable the switch and pick a provider by hand in the chat's
# settings gear.
CHAT_DEFAULT_PROVIDER=openai
#
# How long the chat waits for one agent turn before giving up, in seconds. It is the HTTP client's
# timeout and nothing else, and it is deliberately longer than the agent's own turn budget
# (`AGENT_REQUEST_DEADLINE_S`, 90 above): the agent answers a turn that ran out of time with a
# completed reply saying so, and a client that gave up first would replace that sentence with a bare
# connection error, making a described timeout look like a crash.
CHAT_TIMEOUT_S=180
#
# Login, and off by default. Uncomment both lines below to get a login screen instead of the
# single shared identity above. Accounts are `name:password` pairs separated by commas, and who
# logs in is what decides whose memory, approvals and conversations the chat reaches — logged in
# as alice, those are hers; as bob, none of them are.
#
# This is a demonstration of identity rather than access control: the password is compared against
# plaintext from this file, with no user store, no hashing, no lockout and no revocation. Replace
# it with an identity provider for anything real — the app reads `session.user.identifier`, so
# `@cl.oauth_callback` is a drop-in.
#
# The secret signs the session cookie and Chainlit will not start an auth callback without it.
# Generate one with `uv run --project services/chat chainlit create-secret`, which prints the line
# to paste here. It must be a real secret wherever the chat is shared, and every instance must use
# the same value, or a restart logs everyone out. Leave it empty to keep login off.
# CHAT_USERS=alice:correct-horse,bob:swordfish
# CHAINLIT_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Eval runner (eval/) — which model the suite runs against
# ---------------------------------------------------------------------------
# The suite starts the mock and the agent on free ports and drives the agent's own HTTP contract,
# so there is nothing here to point it at: only the model to choose.
#
# `scripted` answers from fixed rules in this repository. It needs no credential, costs nothing, and
# is what the committed results and CI use — the only setting under which a case that asserts "the
# right tool was chosen" is a regression gate rather than a coin toss.
#
# Any other value names a provider from the list at AGENT_MODEL_PROVIDER above, and the suite then
# runs against a live model. That costs money and is *not* deterministic: a case can fail because
# the model chose differently rather than because anything regressed, so a live run is a finding to
# read rather than a gate to pass. Its credential is read from this file or the shell — the same
# places the agent reads it — handed to the agent process for the run, and never printed or written
# into the results. `eval/provider.py` is the one place that decides all of this.
#
#   EVAL_PROVIDER=openai uv run python -m devtasks eval
#
# A missing or unusable credential is refused before the stack is built, naming the variable.
EVAL_PROVIDER=scripted
