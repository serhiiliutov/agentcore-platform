"""${message}

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
Create Date: ${create_date}

Generated by Alembic from the models in ``agent_service.db.models``. Review the body
before committing: autogenerate detects added and removed tables and columns reliably,
but it cannot know whether dropping a column is intended or an accident, and it does
not detect every index change.
"""

from __future__ import annotations

from collections.abc import Sequence

from alembic import op
import sqlalchemy as sa
${imports if imports else ""}

# Identifiers used by Alembic. `down_revision` is what makes `downgrade` possible, and
# this repository requires a working downgrade for every migration.
revision: str = ${repr(up_revision)}
down_revision: str | None = ${repr(down_revision)}
branch_labels: str | Sequence[str] | None = ${repr(branch_labels)}
depends_on: str | Sequence[str] | None = ${repr(depends_on)}


def upgrade() -> None:
    """Apply this revision."""
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    """Reverse it.

    A migration without a real downgrade is a one-way door. `make downgrade` is part of
    the round-trip test, so an empty body here would be caught rather than shipped.
    """
    ${downgrades if downgrades else "pass"}
